# --- Required ---
TELEGRAM_BOT_TOKEN=your_existing_bot_token
ADMIN_IDS=your_numeric_telegram_id

# --- Send-only Gmail OAuth (shared by every sender) ---
GMAIL_CLIENT_ID=your_existing_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_existing_oauth_client_secret

# --- Sender #1 ---
GMAIL_SENDER=sender1@gmail.com
GMAIL_REFRESH_TOKEN=your_refresh_token_for_sender1

# --- Senders #2-#10 (up to 9 backups). Every report is sent from ALL senders. ---
# Each entry needs its own refresh token. client_id / client_secret are optional
# and fall back to the values above when omitted.
# GMAIL_EXTRA_ACCOUNTS_JSON=[{"email":"sender2@gmail.com","refresh_token":"..."},{"email":"sender3@gmail.com","refresh_token":"..."}]
GMAIL_EXTRA_ACCOUNTS_JSON=[]

# --- Report destinations (optional; defaults shown) ---
# A malformed value falls back to the default and never blocks sending.
# TELEGRAM_REPORT_EMAIL=abuse@telegram.org
# WHATSAPP_REPORT_EMAIL=abuse@whatsapp.com

DATA_DIR=./data
PORT=10000
